# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown files
[*.{md,md.gotmpl}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

# Terraform files
[*.{tf,tfvars,hcl}]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# Batch files
[*.{cmd,bat}]
end_of_line = crlf

# Java files
[*.java]
indent_style = space
indent_size = 4

# JSON files
[*.json]
indent_style = space
indent_size = 2