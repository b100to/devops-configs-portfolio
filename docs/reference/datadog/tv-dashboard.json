{
  "title": "Acme Production V2 - TV Monitor",
  "description": "TV dashboard",
  "widgets": [
    {
      "definition": {
        "title": "SYSTEM STATUS",
        "background_color": "gray",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "ELB Health",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:aws.applicationelb.healthy_host_count{host:acme-main-v2-prd-traefik-*}",
                      "aggregator": "min"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "hosts",
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "RDS CPU",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<",
                      "value": 70,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">=",
                      "value": 70,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 90,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "max:aws.rds.cpuutilization{aws_account:222222222222}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "%",
              "precision": 0
            },
            "layout": {
              "x": 2,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "EKS CPU",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<",
                      "value": 70,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">=",
                      "value": 70,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 90,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:system.cpu.user{cluster_name:acme-main-v2-prd}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "%",
              "precision": 1
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "OpenSearch CPU",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<",
                      "value": 70,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">=",
                      "value": 70,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 90,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "max:aws.es.cpuutilization.maximum{*}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "%",
              "precision": 0
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "EKS Nodes",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:kubernetes_state.node.count{kube_cluster_name:acme-main-v2-prd}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "nodes",
              "precision": 0
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Pods Running",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:kubernetes.pods.running{cluster_name:acme-main-v2-prd}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "pods",
              "precision": 0
            },
            "layout": {
              "x": 10,
              "y": 0,
              "width": 2,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "title": "TRAFFIC",
        "background_color": "vivid_blue",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Current RPS",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:aws.applicationelb.request_count{host:acme-main-v2-prd-traefik-*}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "custom_unit": "req/s",
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Response Time",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<",
                      "value": 300,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">=",
                      "value": 300,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 500,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:aws.applicationelb.target_response_time.average{host:acme-main-v2-prd-traefik-*}.rollup(avg, 60)",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1 * 1000"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "ms",
              "precision": 0
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "5xx Errors",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<",
                      "value": 1,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">=",
                      "value": 1,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 5,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "errors",
                      "query": "sum:aws.applicationelb.httpcode_target_5xx{host:acme-main-v2-prd-traefik-*}.as_rate().rollup(sum, 60)",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "total",
                      "query": "sum:aws.applicationelb.request_count{host:acme-main-v2-prd-traefik-*}.as_rate().rollup(sum, 60)",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "(errors / total) * 100"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "%",
              "precision": 2
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "4xx Errors",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<",
                      "value": 5,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">=",
                      "value": 5,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 10,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "errors",
                      "query": "sum:aws.applicationelb.httpcode_target_4xx{host:acme-main-v2-prd-traefik-*}.as_rate().rollup(sum, 60)",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "total",
                      "query": "sum:aws.applicationelb.request_count{host:acme-main-v2-prd-traefik-*}.as_rate().rollup(sum, 60)",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "(errors / total) * 100"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "custom_unit": "%",
              "precision": 2
            },
            "layout": {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 4
      }
    },
    {
      "definition": {
        "title": "Traffic Trend",
        "show_legend": false,
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "sum:aws.applicationelb.request_count{host:acme-main-v2-prd-traefik-*}.as_rate()"
              }
            ],
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "thick"
            },
            "display_type": "area"
          }
        ],
        "yaxis": {
          "include_zero": true,
          "scale": "linear"
        }
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "title": "ALERTS",
        "background_color": "vivid_orange",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Pod Restarts",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">",
                      "value": 5,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:kubernetes_state.container.restarts{kube_cluster_name:acme-main-v2-prd}",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "OOM Killed",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:kubernetes.containers.state.terminated{cluster_name:acme-main-v2-prd,reason:oomkilled}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "precision": 0
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "CrashLoop",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:kubernetes_state.container.status_report.count.waiting{kube_cluster_name:acme-main-v2-prd,reason:crashloopbackoff}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "precision": 0
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Pending Pods",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">",
                      "value": 3,
                      "palette": "white_on_red"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:kubernetes_state.pod.unschedulable{kube_cluster_name:acme-main-v2-prd}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "precision": 0
            },
            "layout": {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 10,
        "width": 12,
        "height": 3
      }
    }
  ],
  "template_variables": [
    {
      "name": "cluster",
      "prefix": "cluster_name",
      "available_values": [
        "acme-main-v2-prd",
        "acme-main-v2-dev"
      ],
      "default": "acme-main-v2-prd"
    }
  ],
  "layout_type": "ordered",
  "notify_list": []
}