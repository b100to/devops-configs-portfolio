{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LokiS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::acme-main-dev-loki-chunk",
        "arn:aws:s3:::acme-main-dev-loki-chunk/*",
        "arn:aws:s3:::acme-main-dev-loki-ruler",
        "arn:aws:s3:::acme-main-dev-loki-ruler/*",
        "arn:aws:s3:::acme-main-dev-loki-admin",
        "arn:aws:s3:::acme-main-dev-loki-admin/*"
      ]
    }
  ]
}
