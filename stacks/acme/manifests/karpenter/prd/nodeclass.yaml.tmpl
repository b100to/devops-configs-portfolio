apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: ${name}
spec:
  kubelet:
    maxPods: 110
  amiFamily: ${ami_family}
  role: ${karpenter_role}
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${subnet_discovery}
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${sg_discovery}
  amiSelectorTerms:
    - alias: al2023@v20260129
  blockDeviceMappings:
    - deviceName: /dev/xvda
      ebs:
        # 30Gi → 100Gi: 2026-05-13 DiskPressure로 base 노드(2a) 장애, base-b(2c) 노드 kubelet down → 클러스터 장애 재발 방지
        volumeSize: 100Gi
        volumeType: gp3
        encrypted: true
        kmsKeyID: "alias/aws/ebs"
  tags:
    karpenter.sh/discovery: "true"
    Name: ${name_tag}
    Environment: ${environment}